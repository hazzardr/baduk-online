---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Logout - baduk.online">
  <div class="hero min-h-[80vh] bg-base-200">
    <div class="hero-content text-center">
      <div class="max-w-md">
        <div id="signed-in" hidden>
          <h1 class="text-4xl font-bold mb-4">Sign Out</h1>
          <p class="mb-8">
            You are currently signed in as <strong id="user-name"></strong>.
          </p>
          <div class="flex gap-4 justify-center">
            <button type="button" id="logout-btn" class="btn btn-primary">
              Sign Out
            </button>
            <a href="/" class="btn btn-outline">Cancel</a>
          </div>
          <p id="logout-error" class="text-error mt-4" hidden>
            Unable to sign out. Please try again.
          </p>
        </div>

        <div id="signed-out">
          <h1 class="text-4xl font-bold mb-4">Signed Out</h1>
          <p class="mb-8">You have been successfully signed out.</p>
          <div class="flex gap-4 justify-center">
            <a href="/signin" class="btn btn-primary">Sign In Again</a>
            <a href="/" class="btn btn-outline">Go Home</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { getCurrentUser, logout } from "../lib/api";

    const signedIn = document.getElementById("signed-in")!;
    const signedOut = document.getElementById("signed-out")!;
    const userName = document.getElementById("user-name")!;
    const logoutBtn = document.getElementById(
      "logout-btn",
    ) as HTMLButtonElement;
    const logoutError = document.getElementById("logout-error")!;

    getCurrentUser()
      .then((user) => {
        if (!user) return;
        userName.textContent = user.name;
        signedOut.hidden = true;
        signedIn.hidden = false;
      })
      .catch((error) => {
        console.error("Failed to load auth state:", error);
      });

    logoutBtn.addEventListener("click", async () => {
      logoutBtn.disabled = true;
      logoutError.hidden = true;
      try {
        await logout();
        window.location.href = "/";
      } catch (error) {
        console.error("Logout error:", error);
        logoutError.hidden = false;
        logoutBtn.disabled = false;
      }
    });
  </script>
</BaseLayout>
