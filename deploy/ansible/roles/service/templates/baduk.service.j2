[Unit]
Description=Baduk Game Server
# Postgres is a rootless user service, which a system unit cannot depend on.
# If it is not up yet, the server exits and Restart= retries until it is.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=baduk
Group=baduk
WorkingDirectory=/opt/baduk
EnvironmentFile=/opt/baduk/baduk.env
ExecStart=/opt/baduk/baduk
Restart=always
RestartSec=5s

MemoryMax=1024M
TasksMax=512

StandardOutput=journal
StandardError=journal
SyslogIdentifier=baduk

[Install]
WantedBy=multi-user.target
