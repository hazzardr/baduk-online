[Unit]
Description=Postgres

[Container]
# A fixed name so `podman exec postgres` works (quadlet defaults to systemd-postgres).
ContainerName=postgres
Image=docker.io/library/postgres:17.5
# Loopback only: the backend runs on the host and is the only client.
PublishPort=127.0.0.1:5432:5432
EnvironmentFile={{ ansible_env.HOME }}/.config/containers/postgres.env
Volume=postgres-data:/var/lib/postgresql/data:Z

[Service]
Restart=always
MemoryMax=4096M

[Install]
WantedBy=default.target
