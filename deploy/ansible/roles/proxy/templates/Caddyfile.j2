{
    # Global settings
    email rbrianhazzard+badukacme@protonmail.com  # Add your email for ACME notifications

    # Default log format for easier debugging
    log {
        output stdout
        format json
    }
}

*.baduk.online, baduk.online {
    tls {
        dns cloudflare {{ vault_cf_api_token }}
        resolvers 1.1.1.1
    }

    # Add security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-XSS-Protection "1; mode=block"
    }

    # API requests go to the Go backend
    handle /api/* {
        reverse_proxy 127.0.0.1:{{ baduk_port }} {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Everything else is the static Astro build (frontend/dist), served from the
    # same origin so session cookies and CSRF checks work without CORS.
    handle {
        root * {{ caddy_www_container_dir }}
        try_files {path} {path}/index.html
        file_server
    }

    handle_errors 404 {
        root * {{ caddy_www_container_dir }}
        rewrite * /404.html
        file_server
    }
}

http://*.baduk.online, http://baduk.online {
    redir https://{host}{uri} permanent
}
